<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="panelRaiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="una.sistemareservas.controller.MenuPrincipalViewController">

   <!-- ===================== IZQUIERDA: Opciones + pestañas ===================== -->
   <center>
      <VBox spacing="6.0" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="lblOpciones" text="Opciones:">
               <font>
                  <Font name="Arial Bold" size="13.0" />
               </font>
            </Label>
            <VBox style="-fx-border-color: #b5b5b5; -fx-border-radius: 4;" VBox.vgrow="ALWAYS">
               <padding>
                  <Insets bottom="6.0" left="8.0" right="8.0" top="8.0" />
               </padding>
               <children>
                  <!-- fx:id en cada include = el controlador de esa pestaña queda disponible como "<fx:id>Controller" -->
                  <TabPane fx:id="tabPaneMenuPrincipal" prefHeight="700.0" prefWidth="820.0" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <tabs>
                      <Tab fx:id="tabReservas" text="Reservas">
                        <content>
                          <fx:include fx:id="vistaReservas" source="ReservasView.fxml" />
                        </content>
                      </Tab>
                      <Tab fx:id="tabFuncionarios" text="Funcionarios">
                        <content>
                          <fx:include fx:id="vistaFuncionarios" source="FuncionariosView.fxml" />
                        </content>
                      </Tab>
                      <Tab fx:id="tabCategorias" text="Categorias">
                        <content>
                          <fx:include fx:id="vistaCategorias" source="CategoriasView.fxml" />
                        </content>
                      </Tab>
                      <Tab fx:id="tabRecursos" text="Recursos">
                        <content>
                          <fx:include fx:id="vistaRecursos" source="RecursosView.fxml" />
                        </content>
                      </Tab>
                      <Tab fx:id="tabCalendarizacion" text="Calendarizacion">
                        <content>
                          <fx:include fx:id="vistaCalendarizacion" source="CalendarizacionView.fxml" />
                        </content>
                      </Tab>
                      <Tab fx:id="tabActividades" text="Actividades">
                        <content>
                          <fx:include fx:id="vistaActividades" source="ActividadesView.fxml" />
                        </content>
                      </Tab>
                      <Tab fx:id="tabEstadisticas" text="Estadisticas">
                        <content>
                          <fx:include fx:id="vistaEstadisticas" source="EstadisticasView.fxml" />
                        </content>
                      </Tab>
                    </tabs>
                  </TabPane>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </center>

   <!-- ===================== DERECHA: Área de Alertas (siempre visible) ===================== -->
   <right>
      <VBox prefWidth="380.0" spacing="6.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Alertas">
               <font>
                  <Font name="Arial Bold" size="13.0" />
               </font>
            </Label>
            <VBox style="-fx-border-color: #b5b5b5; -fx-border-radius: 4;" VBox.vgrow="ALWAYS">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <children>
                  <TableView fx:id="tabAlertas" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colAlertaActividad" prefWidth="250.0" text="Actividad" />
                      <TableColumn fx:id="colAlertaVer" prefWidth="48.0" sortable="false" style="-fx-alignment: CENTER;" text="Ver" />
                      <TableColumn fx:id="colAlertaDescartar" prefWidth="52.0" sortable="false" style="-fx-alignment: CENTER;" text="Desc." />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <placeholder>
                        <Label text="No hay alertas" textFill="#808080" />
                     </placeholder>
                  </TableView>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </right>
</BorderPane>
